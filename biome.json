{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "!src/components/ui",
      "!src/server/db/migrations",
      "!.claude/worktrees",
      "public/**",
      "drizzle.config.ts",
      "next.config.ts",
      "postcss.config.cjs",
      "components.json",
      "package.json",
      "tsconfig.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "options": {
            "paths": {
              "zod": {
                "importNames": ["z"],
                "message": "Use `import * as z from \"zod\"` instead of `import { z }`."
              }
            },
            "patterns": [
              {
                "group": ["@/modules/*/**", "**/modules/*/**"],
                "message": "An optional module is reached through its registry (`@/modules/<point>`), never directly: removing the module must not break this file. See src/modules/registry.ts."
              }
            ]
          },
          "level": "error"
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useUniqueElementIds": "off",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "error"
      },
      "complexity": {
        "noForEach": "warn",
        "useFlatMap": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "options": {
                "paths": {
                  "zod": {
                    "importNames": ["z"],
                    "message": "Use `import * as z from \"zod\"` instead of `import { z }`."
                  }
                }
              },
              "level": "error"
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
