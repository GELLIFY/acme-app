# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/main" # use "db" inside docker and "localhost" when running locally
# Note: `pnpm dev` auto-writes a per-worktree DATABASE_URL and BETTER_AUTH_URL to
# .env.local (which overrides this file), pointing at a database named after the
# current git branch in the shared local Postgres. Override the base with POSTGRES_BASE_URL.

# Auth
BETTER_AUTH_SECRET="replace-with-a-32-char-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Email
RESEND_API_KEY="re_123"

# #if useWorker
# Background worker. "local" (default) leaves a queued job for `pnpm worker`'s poll loop (see
# docker-compose.yml's "worker" service) to pick up -- no AWS needed. "ecs" calls ecs:RunTask;
# ECS_CLUSTER/WORKER_* below are then injected automatically by acme-app-aws once
# `withFargateTask` is enabled on that stack, not hand-configured here.
JOB_DRIVER="local"
# ECS_CLUSTER="replace-with-ecs-cluster-name"
# WORKER_TASK_DEFINITION="replace-with-task-definition-family"
# WORKER_CONTAINER_NAME="replace-with-worker-container-name"
# WORKER_SECURITY_GROUP_ID="sg-aaa"
# WORKER_SUBNET_IDS="subnet-aaa,subnet-bbb"
# #endif

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <bearer_token>"
# OTEL_LOG_LEVEL=debug
OTEL_TRACES_SAMPLER=parentbased_traceidratio # se il parent è sampled → eredita
OTEL_TRACES_SAMPLER_ARG=0.05 # base: 5% di traffico normale
# NEXT_OTEL_VERBOSE=1
# NODE_EXTRA_CA_CERTS="ca.crt"
# NODE_TLS_REJECT_UNAUTHORIZED="0"
