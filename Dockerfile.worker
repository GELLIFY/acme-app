# syntax=docker/dockerfile:1@sha256:2780b5c3bab67f1f76c781860de469442999ed1a0d7992a5efdf2cffc0e3d769
#
# Image for a Run's ephemeral ECS Fargate task (#40 — "04: Esecuzione della Run come job effimero
# su ECS Fargate"), per acme-app-aws's `EcsFargateTask` invocation contract
# (infrastructure/components/ecs-fargate-task.md there): the container entrypoint polls the DB for
# queued Runs and drains them one after another (see `scripts/worker.ts`) until nothing is left,
# then exits — no per-Run override needed. Unlike `Dockerfile` (the always-on web service, Next.js
# standalone output), this image runs to completion and exits — no HTTP server, no Next build, just
# this repo's source plus `bun` to run `scripts/worker.ts` directly against the same database and
# S3 bucket the app uses. It also serves as `docker-compose.yml`'s local "worker" service.
#
# A separate image (not the same one `Dockerfile` builds) because that one is a slim Next.js
# standalone bundle that does not carry the raw TypeScript source or full `node_modules`
# `scripts/worker.ts` needs. acme-app-aws's `index.ts` points `EcsFargateTask`'s `containerImage`
# at this image's own tag (`<appVersion>-worker`, see the worker image build step in
# `.github/workflows/cd/aws/deploy-test/action.yml`), not at the web service's — and, matching
# `EcsFargateTask`'s default `fargateTaskCommand` (`["pnpm", "worker"]`), the CMD below runs
# through `pnpm`, not a bare `bun` entrypoint, so no Pulumi-side command override is needed.
#
# Dependencies are installed with pnpm — not `bun install`, which does not understand this
# repository's pnpm-lock.yaml or its patched dependencies — with `bun` added only as the runtime
# that executes `scripts/worker.ts`'s TypeScript directly, no separate build step.
#
# TODO(#40): pin both base images to a digest once Renovate has picked them up (see
# `renovate.json`'s digest-pinning rule, same as `Dockerfile`'s base image) — left as tags here
# since this agent has no registry access to resolve one.
FROM node:22.22.2-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN corepack enable pnpm && pnpm install --frozen-lockfile --prod=false

FROM node:22.22.2-alpine
WORKDIR /app
RUN corepack enable pnpm
COPY --from=oven/bun:1.2-alpine /usr/local/bin/bun /usr/local/bin/bun
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NODE_ENV=production

CMD ["pnpm", "worker"]
