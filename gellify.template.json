{
  "$comment": "What create-gellify-app removes from this repository when a project declines a module or a flag. Read by the generator, never copied into a project. See AGENTS.md, section 'This repository is also a template'.",
  "registries": [
    "src/modules/auth.ts",
    "src/modules/auth-client.ts",
    "src/modules/trpc.ts",
    "src/modules/rest.ts",
    "src/modules/schema.ts",
    "src/modules/sign-in.ts",
    "src/modules/account-security.ts",
    "src/modules/account-tab.ts",
    "src/modules/rest-auth.ts",
    "src/modules/nav.ts",
    "src/modules/permissions.ts",
    "src/modules/seed.ts",
    "src/modules/health.ts",
    "src/modules/locales.ts",
    "src/modules/user-menu.ts",
    "src/modules/overlay.ts"
  ],
  "regenerate": [
    "src/server/db/migrations"
  ],
  "templateOnly": [
    "src/modules/manifest.test.ts",
    ".github/workflows/template.yml"
  ],
  "modules": {
    "auth.admin": {
      "dir": "admin",
      "files": [
        "src/app/[locale]/(app)/admin"
      ]
    },
    "auth.apiKey": {
      "dir": "api-key",
      "dependencies": [
        "@better-auth/api-key"
      ]
    },
    "auth.twoFactor": {
      "dir": "two-factor",
      "files": [
        "src/app/[locale]/(public)/(auth)/2fa",
        "src/components/ui/input-otp.tsx"
      ],
      "dependencies": [
        "input-otp",
        "react-qr-code"
      ]
    },
    "auth.organization": {
      "dir": "organization",
      "files": [
        "src/app/[locale]/(app)/organization",
        "src/emails/organization-invitation-email.tsx"
      ]
    },
    "auth.passkey": {
      "dir": "passkey",
      "dependencies": [
        "@better-auth/passkey"
      ]
    },
    "example": {
      "dir": "todo",
      "files": [
        "src/app/[locale]/(app)/todo",
        "src/components/error-fallback.tsx"
      ],
      "dependencies": [
        "react-error-boundary"
      ]
    },
    "rest": {
      "dir": "rest",
      "files": [
        "src/server/api/rest",
        "src/app/api/rest",
        "src/modules/rest.ts",
        "src/modules/rest-auth.ts",
        "src/tests/http.ts",
        "src/tests/http.test.ts"
      ],
      "dependencies": [
        "hono",
        "@hono/zod-openapi",
        "@scalar/hono-api-reference",
        "hono-rate-limiter"
      ]
    },
    "example+rest": {
      "requires": [
        "example",
        "rest"
      ],
      "files": [
        "src/modules/todo/rest.ts",
        "src/modules/todo/server/rest-routes.ts",
        "src/modules/todo/server/rest-routes.test.ts"
      ]
    },
    "auth.apiKey+rest": {
      "requires": [
        "auth.apiKey",
        "rest"
      ],
      "files": [
        "src/modules/api-key/rest-auth.ts"
      ]
    }
  },
  "sharedDependencies": {
    "@tanstack/react-table": [
      "auth.admin",
      "auth.organization"
    ],
    "date-fns": [
      "auth.apiKey",
      "auth.admin"
    ]
  },
  "flags": {
    "deployVercel": {
      "files": [
        ".github/workflows/cd/vercel"
      ]
    },
    "deployAws": {
      "files": [
        ".github/workflows/cd/aws"
      ]
    },
    "useWorker": {
      "files": [
        "Dockerfile.worker",
        "scripts/worker.ts",
        "scripts/direct-database-url.ts",
        "scripts/direct-database-url.test.ts",
        "src/server/services/jobs",
        ".github/workflows/cd/aws/*-worker"
      ],
      "scripts": [
        "worker"
      ],
      "dependencies": [
        "@aws-sdk/client-ecs"
      ]
    }
  }
}
