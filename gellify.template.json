{
  "$comment": "What create-gellify-app removes from this repository when a project declines a module or a flag. Read by the generator, never copied into a project. See AGENTS.md, section 'This repository is also a template'.",
  "registries": [
    "src/modules/auth.ts",
    "src/modules/auth-client.ts",
    "src/modules/trpc.ts",
    "src/modules/rest.ts",
    "src/modules/schema.ts",
    "src/modules/sign-in.ts",
    "src/modules/account-security.ts",
    "src/modules/account-tab.ts",
    "src/modules/rest-auth.ts",
    "src/modules/nav.ts",
    "src/modules/permissions.ts",
    "src/modules/seed.ts",
    "src/modules/locales.ts"
  ],
  "regenerate": [
    "src/server/db/migrations"
  ],
  "templateOnly": [
    "src/modules/manifest.test.ts"
  ],
  "modules": {
    "auth.apiKey": {
      "dir": "api-key",
      "dependencies": [
        "@better-auth/api-key"
      ]
    },
    "auth.twoFactor": {
      "dir": "two-factor",
      "files": [
        "src/app/[locale]/(public)/(auth)/2fa",
        "src/components/ui/input-otp.tsx"
      ],
      "dependencies": [
        "input-otp",
        "react-qr-code"
      ]
    },
    "auth.passkey": {
      "dir": "passkey",
      "dependencies": [
        "@better-auth/passkey"
      ]
    },
    "example": {
      "dir": "todo",
      "files": [
        "src/app/[locale]/(app)/todo",
        "src/components/error-fallback.tsx"
      ],
      "dependencies": [
        "react-error-boundary"
      ]
    }
  },
  "sharedDependencies": {
    "date-fns": [
      "auth.apiKey",
      "auth.admin"
    ]
  },
  "flags": {
    "deployVercel": {
      "files": [
        ".github/workflows/cd/vercel"
      ]
    },
    "deployAws": {
      "files": [
        ".github/workflows/cd/aws"
      ]
    },
    "useWorker": {
      "files": [
        "Dockerfile.worker",
        "scripts/worker.ts",
        "scripts/direct-database-url.ts",
        "scripts/direct-database-url.test.ts",
        "src/server/services/jobs",
        ".github/workflows/cd/aws/*-worker"
      ],
      "scripts": [
        "worker"
      ],
      "dependencies": [
        "@aws-sdk/client-ecs"
      ]
    }
  }
}
